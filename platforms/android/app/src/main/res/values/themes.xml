<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIVPN" parent="Theme.AIVPN.Base" />
    <style name="Theme.AIVPN.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/grey</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorError">@color/disconnect</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/disconnect</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/navigation_bar_legacy</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:fontFamily">sans</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:editTextStyle">@style/Widget.AIVPN.EditText</item>
        <item name="editTextStyle">@style/Widget.AIVPN.EditText</item>
        <item name="materialAlertDialogTheme">@style/Theme.AIVPN.Dialog</item>
        <item name="materialButtonStyle">@style/Widget.AIVPN.Button</item>
        <item name="materialCardViewStyle">@style/Widget.AIVPN.Card</item>
        <item name="checkboxStyle">@style/Widget.Material3.CompoundButton.CheckBox</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="boxStrokeColor">@color/accent</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <style name="Theme.AIVPN.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />
    <style name="Widget.AIVPN.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <style name="Widget.AIVPN.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.AIVPN.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>
    <style name="TextAppearance.AIVPN.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.AIVPN.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
