DATABASE_URL=file:./data/aivpn-web.db
# DATABASE_URL=postgres://user:pass@localhost:5432/aivpn_web
JWT_SECRET=change-me-to-a-long-random-string
# AES-256-GCM key for encrypting TOTP secrets at rest.
# Required when using TOTP 2FA. Generate: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
ORIGIN=https://vpn.example.com
PORT=8080
UNIX_SOCK=/run/aivpn/api.sock
# AIVPN_WEB_ADMIN_PASSWORD=initial-admin-password

# ── Docker: non-root container / management socket group ───────────────────
# The Dockerfile runs this panel as the non-root `bun` user (uid=gid=1000).
# For that uid to open aivpn-server's management socket at UNIX_SOCK above,
# the SERVER (not this app) must be configured with
#   management_socket_group=1000
# in its own config (server.json / CLI flag) so it creates the socket
# group-owned by gid 1000, mode 0660, instead of mode 0600 root-only. This is
# a server-side setting, not an env var read by aivpn-web — set it on the
# aivpn-server host/container, or run this container with a matching
# --group-add if the server uses a different gid.

# Trust X-Forwarded-For / X-Real-IP headers for client IP (rate limiting,
# audit log, session records).
#
# The recommended deployment (deploy/nginx/aivpn-web.conf) fronts the panel
# with nginx, which OVERWRITES X-Forwarded-For with the real peer address —
# so the default here is true. With this set to false behind a proxy, every
# visitor resolves to 127.0.0.1 and shares ONE per-IP rate-limit bucket:
# a single failed login locks everyone out.
#
# Set to false ONLY if the panel is directly reachable (no reverse proxy) —
# in that case honouring the header would let any client spoof its IP to
# bypass per-IP rate limits and forge audit-log entries.
AIVPN_WEB_TRUST_PROXY=true

# Request-body caps on the /api/v1 proxy (bytes). The general cap bounds
# memory against oversized payloads; backup imports have their own larger cap
# (the management daemon accepts backups up to 50 MB).
# PROXY_MAX_BODY_BYTES=1048576
# PROXY_MAX_BACKUP_BODY_BYTES=67108864

# ── OIDC / SSO (optional) ────────────────────────────────────────────────────
# OIDC_MODE=disabled          # disabled | enabled | exclusive
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=         # optional for public PKCE clients
# OIDC_ROLE_CLAIM=role        # ID token claim to read role from
# OIDC_ADMIN_VALUE=admin      # claim value that grants admin role
