{
  "name": "aivpn-web-server",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ../dist --target bun --external @node-rs/argon2",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.4.3",
    "@node-rs/argon2": "^2.2.1",
    "@simplewebauthn/server": "^13.3.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "jose": "^5.10.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "systeminformation": "^5.33.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "bun-types": "^1.4.2",
    "typescript": "^5.9.3",
    "drizzle-kit": "^0.31.11"
  }
}
