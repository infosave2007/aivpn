#!/bin/sh /etc/rc.common
# AIVPN client init script for OpenWrt

USE_PROCD=1
START=90
STOP=10

PROG=/usr/bin/aivpn-client
# UCI config — procd watches this file and restarts the service on change
CONFIG=/etc/config/aivpn

configure_router_guard() {
    if [ "$1" = 1 ]; then
        nft -f - <<'EOF'
add table inet aivpn_router_guard
add chain inet aivpn_router_guard forward { type filter hook forward priority -20; policy accept; }
flush chain inet aivpn_router_guard forward
add rule inet aivpn_router_guard forward iifname != "aivpn0" oifname != "aivpn0" drop
EOF
    else
        nft delete table inet aivpn_router_guard 2>/dev/null || true
    fi
}

start_service() {
    local enabled kill_switch connection_key server server_key preshared_key server_signing_key mask_operator_pubkey

    config_load aivpn
    config_get_bool enabled main enabled 0
    config_get_bool kill_switch main kill_switch 0
    config_get connection_key main connection_key ""
    config_get server main server ""
    config_get server_key main server_key ""
    config_get preshared_key main preshared_key ""
    config_get server_signing_key main server_signing_key ""
    config_get mask_operator_pubkey main mask_operator_pubkey ""

    if [ "$enabled" != 1 ]; then
        configure_router_guard 0
        return 0
    fi

    configure_router_guard "$kill_switch" || return 1

    if [ -z "$connection_key" ] && { [ -z "$server" ] || [ -z "$server_key" ] || [ -z "$preshared_key" ]; }; then
        echo "aivpn: configure connection_key or server/server_key/preshared_key" >&2
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG"

    if [ -n "$connection_key" ]; then
        procd_set_param env "AIVPN_CONNECTION_KEY=$connection_key"
    else
        procd_append_param command --server "$server" --server-key "$server_key"
        procd_set_param env "AIVPN_PRESHARED_KEY=$preshared_key"
    fi
    [ -z "$server_signing_key" ] || procd_append_param command --server-signing-key "$server_signing_key"
    [ -z "$mask_operator_pubkey" ] || procd_append_param command --mask-operator-pubkey "$mask_operator_pubkey"

    procd_append_param command --tun-name aivpn0 --full-tunnel
    [ "$kill_switch" = 0 ] || procd_append_param command --kill-switch
    procd_set_param file "$CONFIG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 0
    procd_close_instance
}

stop_service() {
    configure_router_guard 0
}

service_triggers() {
    procd_add_reload_trigger "aivpn"
}
