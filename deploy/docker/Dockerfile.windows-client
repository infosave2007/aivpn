# AIVPN Windows Client Build Dockerfile
# Requires rustc 1.88+: wintun-bindings 0.7.39 (pulled in only for the
# windows target) depends on libloading 0.9.0, whose Cargo.toml pins
# rust-version = "1.88.0" — verified against the upstream Cargo.toml
# (github.com/nagisa/rust_libloading, tag 0.9.0) before picking this tag.
# Pinned to a concrete Debian-slim tag instead of the floating `rust:latest`.
# Uses clang with Windows GNU target (no MSVC required)
# TODO(security): pin with @sha256:<digest> once a digest is chosen to track.

FROM rust:1.88-slim AS builder

WORKDIR /app

# Install dependencies for Windows cross-compilation with GNU toolchain
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    clang \
    llvm \
    mingw-w64 \
    && rm -rf /var/lib/apt/lists/*

# Add Windows GNU target (compatible with most Windows systems)
RUN rustup target add x86_64-pc-windows-gnu

# Set up clang as the compiler for Windows GNU target
ENV CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc
ENV CXX_x86_64_pc_windows_gnu=x86_64-w64-mingw32-g++

# Copy workspace
COPY Cargo.toml ./
COPY Cargo.lock* ./
COPY crates/aivpn-common crates/aivpn-common/
COPY crates/aivpn-client crates/aivpn-client/
COPY crates/aivpn-server crates/aivpn-server/
COPY crates/aivpn-android-core crates/aivpn-android-core/
COPY crates/aivpn-windows crates/aivpn-windows/
COPY crates/aivpn-ios-core crates/aivpn-ios-core/
COPY crates/aivpn-linux crates/aivpn-linux/
COPY assets/masks assets/masks/

# Build Windows client in release mode (GNU ABI)
RUN cargo build --release --target x86_64-pc-windows-gnu --bin aivpn-client

# Stage 2: Extract binary
# Pinned to match the version already used by platforms/mikrotik/Dockerfile.
# TODO(security): pin with @sha256:<digest> once a digest is chosen to track.
FROM alpine:3.19
COPY --from=builder /app/target/x86_64-pc-windows-gnu/release/aivpn-client.exe /aivpn-client.exe
