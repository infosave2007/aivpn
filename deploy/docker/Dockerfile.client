# AIVPN Client Test Dockerfile
# rust:1.97-slim-trixie — current stable Rust on Debian 13 (trixie), matching
# the runtime stage below so the dynamically linked binary finds the same glibc.
FROM rust:1.97-slim-trixie AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire workspace (needed for Cargo.toml workspace resolution). The whole
# crates/ tree is copied rather than an explicit per-crate list: cargo needs
# every member listed in Cargo.toml to be present, so an enumerated list breaks
# the moment a workspace member is added.
COPY Cargo.toml Cargo.lock ./
COPY crates crates/
COPY assets/masks assets/masks/

# --locked: build the exact dependency set recorded in Cargo.lock, so the test
# client is built from the same graph as the server image.
RUN cargo build --locked --release --bin aivpn-client

# Stage 2: Runtime
# debian:trixie-slim — same Debian release as the builder stage above.
# TODO(security): pin with @sha256:<digest> once a digest is chosen to track.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    iproute2 \
    iptables \
    iputils-ping \
    curl \
    netcat-openbsd \
    bc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/aivpn-client /usr/local/bin/aivpn-client

RUN mkdir -p /dev/net && \
    { mknod /dev/net/tun c 10 200 2>/dev/null || true; } && \
    { [ ! -e /dev/net/tun ] || chmod 600 /dev/net/tun; }

ENTRYPOINT ["/usr/local/bin/aivpn-client"]
